{
  "name": "@parsa-emami/policyhelix-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "PolicyHelix web application foundation",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "prepare:web": "node scripts/generate-web-data.mjs",
    "dev": "npm run prepare:web && vite --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run prepare:web && npm run typecheck && vite build --config apps/web/vite.config.ts",
    "build:engine": "go build -o dist/engine/policyhelix ./cmd/policyhelix",
    "start": "node scripts/start-local.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "test": "node --test tests/web/*.test.mjs tests/contracts/*.test.mjs",
    "test:engine": "go test ./...",
    "test:browser": "playwright test",
    "package:web": "node scripts/package-web.mjs",
    "validate:plan": "node scripts/roadmap.mjs validate",
    "check": "npm run validate:plan && npm run build && npm run build:engine && npm test && npm run test:engine",
    "setup": "node scripts/oss-bootstrap.mjs setup",
    "doctor": "node scripts/oss-bootstrap.mjs doctor",
    "plan": "node scripts/roadmap.mjs",
    "release:check": "node scripts/roadmap.mjs release-check",
    "test:clone": "node scripts/clone-smoke.mjs",
    "pretest": "npm run build:engine"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.64.1"
  }
}
