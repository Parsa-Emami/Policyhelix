{
  "project": "PolicyHelix",
  "hardware": {
    "vcpu": 2,
    "ram_mib": 4096,
    "free_disk_mib": 10240,
    "measurement": "Unmeasured planning target; C28 must verify or reduce it."
  },
  "engine_language": "Go",
  "engine_version": "1.26.2",
  "runtime_environment": {
    "node": "v24.19.0",
    "npm": "11.17.0",
    "go": "1.26.2"
  },
  "providers": [
    {
      "name": "local OPA",
      "version": "v1.2.0",
      "required": true,
      "privilege": "unprivileged local process or embedded library",
      "license": "Apache-2.0"
    },
    {
      "name": "self-hosted Keycloak/OIDC",
      "version": "26.1.3",
      "required": true,
      "privilege": "unprivileged local daemon or standard container on loopback",
      "license": "Apache-2.0"
    },
    {
      "name": "owned synthetic demo upstream",
      "version": "0.0.1",
      "required": true,
      "privilege": "unprivileged loopback HTTP service",
      "license": "Apache-2.0"
    }
  ],
  "privileges": {
    "root_required": false,
    "network_binding": "loopback only (127.0.0.1 / ::1)",
    "filesystem_access": "read and write within repository and working data directory only",
    "cloud_or_telemetry_dialout": false
  },
  "capacity_limits": {
    "protected_apps": 1,
    "users": 5,
    "decision_deadline_ms": 200,
    "session_ttl_minutes": 15,
    "revocation_bound_seconds": 30
  },
  "current_shell_requires": [
    "Git",
    "Node 24.19+ within Node 24 (npm included)",
    "Go 1.26+ for engine compilation and launch"
  ],
  "full_engine_platform_target": "Linux x86_64; other platforms need their own installed evidence",
  "paid_or_cloud_account_required": false,
  "owned_domain_required": false,
  "versions": {
    "locked_at": "C02",
    "node": "24.19.0",
    "npm": "11.17.0",
    "go": "1.26.2",
    "opa": "v1.2.0",
    "keycloak": "26.1.3"
  }
}
