{
  "schema_version": 1,
  "spec_id": "policyhelix-source-build",
  "title": "Independent Source Build Specification",
  "source_build_guarantee": "Clean build from public source repository without proprietary compilers or pre-built binaries",
  "toolchain": {
    "engine": "Go >= 1.26",
    "web": "Node >= 24.19.0 < 25 (npm bundled)"
  },
  "build_targets": [
    {
      "target": "engine_binary",
      "command": "go build -o dist/engine/policyhelix ./cmd/policyhelix",
      "output": "dist/engine/policyhelix",
      "offline_capable": true
    },
    {
      "target": "web_bundle",
      "command": "npm run build",
      "output": "dist/web/",
      "offline_capable": true
    },
    {
      "target": "source_archive",
      "command": "npm run package:source",
      "output": "dist/release/policyhelix-source.tar.gz",
      "offline_capable": true
    }
  ],
  "network_isolation": {
    "post_setup_external_network_required": false,
    "compulsory_telemetry": false
  }
}
