# Safe local placeholders only. Copy to .env locally; never commit .env or real credentials.
APP_ENV=local
SERVICE_NAME=policyhelix
DATABASE_DSN_REF=secret://local/postgres-dsn
VALKEY_DSN_REF=secret://local/valkey-dsn
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
LOG_LEVEL=info
OIDC_ISSUER=https://idp.local
OIDC_CLIENT_ID=policyhelix-local
OIDC_CLIENT_SECRET_REF=secret://local/oidc-client-secret
OPA_BUNDLE_SIGNING_KEY_REF=secret://local/opa-bundle-signing-key
ENVOY_EXT_AUTHZ_TIMEOUT_MS=500
FAIL_CLOSED=true
